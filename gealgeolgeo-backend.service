[Unit]
Description=GealGeolGeo Backend (FastAPI)
After=network.target

[Service]
Type=simple
User=ryandshine
WorkingDirectory=/home/ryandshine/gealgeolgeo
ExecStart=/home/ryandshine/gealgeolgeo/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
Environment="PATH=/home/ryandshine/gealgeolgeo/.venv/bin:/usr/local/bin:/usr/bin:/bin"

[Install]
WantedBy=multi-user.target
