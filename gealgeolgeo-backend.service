[Unit]
Description=GealGeolGeo Backend (FastAPI)
After=network.target

[Service]
Type=simple
User=ryandshinevps
WorkingDirectory=/home/ryandshinevps/gealgeolgeo
ExecStart=/home/ryandshinevps/gealgeolgeo/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
Environment="PATH=/home/ryandshinevps/gealgeolgeo/.venv/bin:/usr/local/bin:/usr/bin:/bin"

[Install]
WantedBy=multi-user.target
